{
  "name": "hamsafarhub-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for HamsafarHub",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
